<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>18ab1d20-bb15-43b1-8d20-1a5607c61e21</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
	  <DockerComposeProjectPath>..\..\..\docker-compose.dcproj</DockerComposeProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Carter đúng version .NET 8 -->
    <PackageReference Include="Carter" Version="8.0.0" />

    <!-- MassTransit bản mới nhất cho .NET 8 -->
    <PackageReference Include="MassTransit" Version="8.5.5" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.5" />

    <!-- MediatR mới nhất, tương thích .NET 8 -->
    <PackageReference Include="MediatR" Version="12.2.0" />

    <!-- Mapster giữ nguyên -->
    <PackageReference Include="Mapster" Version="7.4.0" />

    <!-- HealthChecks dành cho .NET 8 -->
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="8.0.1" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="8.0.1" />

    <!-- OpenAPI (Swagger) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />

    <!-- EF Core Design 8.x để chạy migrations -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="prometheus-net.SystemMetrics" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Integrations\Integrations.Consul\Integrations.Consul.csproj" />
    <ProjectReference Include="..\Voucher.Application\Voucher.Application.csproj" />
    <ProjectReference Include="..\Voucher.Infrastructure\Voucher.Infrastructure.csproj" />
    <ProjectReference Include="..\Voucher.Shared\Voucher.Shared.csproj" />

    <!-- ADD THIS ONE BELOW -->
    <ProjectReference Include="..\Voucher.Messaging\Voucher.Messaging.csproj" />
  </ItemGroup>

</Project>
