<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference to Integrations.Messaging where OrderPlacedEvent lives -->
    <ProjectReference Include="..\..\..\Integrations\Integrations.Messaging\Integrations.Messaging.csproj" />

    <!-- Reference to Voucher.Infrastructure (for VoucherWriteDbContext) -->
    <ProjectReference Include="..\Voucher.Infrastructure\Voucher.Infrastructure.csproj" />

    <!-- MassTransit packages -->
    <PackageReference Include="MassTransit" Version="8.5.5" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.5" />

    <!-- EF Core needed for DbContext usage -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.6" />
  </ItemGroup>

</Project>
