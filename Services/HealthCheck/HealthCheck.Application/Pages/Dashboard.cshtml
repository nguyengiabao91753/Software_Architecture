@page
@model HealthCheck.Application.Pages.DashboardModel
@{
    ViewData["Title"] = "System Health Dashboard";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container my-4">
    <h1 class="mb-3">System Health Dashboard</h1>

    <div class="row mb-3" id="summary-cards">
        <!-- Cards injected by JS -->
    </div>

    <div class="row mb-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">Services Status</div>
                <div class="card-body">
                    <canvas id="statusChart" height="120"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">Quick Stats</div>
                <div class="card-body">
                    <ul class="list-group" id="quick-stats">
                        <!-- injected by JS -->
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">All Registered Services (Consul)</div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm table-hover" id="services-table">
                    <thead class="table-light">
                        <tr>
                            <th>Service</th>
                            <th>Service ID</th>
                            <th>Address</th>
                            <th>Port</th>
                            <th>Status</th>
                            <th>Output</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="/js/dashboard.js"></script>
